# Figma personal access token
# https://www.figma.com/developers/api#access-tokens
# Copy to .env (gitignored). Never use VITE_* — the web bundle must not contain secrets.
FIGMA_ACCESS_TOKEN=

# Local Ollama vision (company_excel과 동일). 텍스트 없는 이미지 노드 분석에 사용.
# OLLAMA_VISION=0 이면 비전 분석을 건너뜁니다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
