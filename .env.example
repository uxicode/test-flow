# ── Figma 연동 ─────────────────────────────────────────────────────────────
# Figma Personal Access Token (https://www.figma.com/settings → Access tokens)
# 브라우저에 저장하지 않고 서버에서만 사용합니다.
FIGMA_TOKEN=your_figma_personal_access_token_here

# ── 테스트 공통 계정 ────────────────────────────────────────────────────────
# 로그인이 필요한 TC 실행 시 사용하는 공유 테스트 계정.
# 브라우저에 저장하지 않고 서버 런타임에서만 사용합니다.
TEST_ACCOUNT_EMAIL=test@example.com
TEST_ACCOUNT_PASSWORD=your_test_password_here

# ── TC 파일 저장 디렉터리 (선택) ────────────────────────────────────────────
# 기본값: <repo-root>/data/tc  (git-ignored, .gitkeep 으로 디렉터리만 추적)
# TC_FILE_DIR=/absolute/path/to/tc-output

# ── 로컬 Ollama ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 텍스트 기획서
OLLAMA_TEXT_MODEL=gemma2:9b
# 피그마 화면(스크린샷) 매칭
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_MODEL=gemma2:9b
# 비전 PNG 긴 변(px) 상한 · 기본 768
# OLLAMA_VISION_MAX_SIDE=768
# 비전 num_ctx · 기본 4096 (컨텍스트 부족 시 8192)
# OLLAMA_VISION_NUM_CTX=4096
# chat keep_alive · 기본 0 (응답 직후 GPU 해제)
# OLLAMA_KEEP_ALIVE=0
